<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CozyKey.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <!-- Hàng trên: Icon tòa nhà + Tên/Số tầng + Nút Sửa/Xóa (Admin) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_secondary"
                android:padding="9dp"
                android:src="@drawable/ic_rooms"
                app:tint="@color/primary" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBuildingName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tên tòa nhà"
                    android:textAppearance="@style/TextAppearance.CozyKey.Title" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvFloorBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_secondary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0 tầng"
                        android:textAppearance="@style/TextAppearance.CozyKey.Caption"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRoomScaleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_secondary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0 phòng"
                        android:textAppearance="@style/TextAppearance.CozyKey.Caption"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cụm nút Sửa / Xóa chỉ hiện cho Admin -->
            <LinearLayout
                android:id="@+id/layoutAdminActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditBuilding"
                    style="@style/Widget.CozyKey.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="🖉"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteBuilding"
                    style="@style/Widget.CozyKey.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="Xóa"
                    android:textColor="@color/error"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/error_container" />
            </LinearLayout>
        </LinearLayout>

        <!-- Địa chỉ tòa nhà -->
        <TextView
            android:id="@+id/tvBuildingAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_secondary"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="Địa chỉ tòa nhà"
            android:textAppearance="@style/TextAppearance.CozyKey.Caption"
            android:textColor="@color/text_secondary" />

        <!-- 3 ô thống kê trạng thái dùng MaterialCardView theo style card chung -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Ô 1: Đang thuê -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CozyKey.Card.Variant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang thuê"
                        android:textAppearance="@style/TextAppearance.CozyKey.Caption"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvStatOccupied"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_status_success"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0 phòng"
                        android:textAppearance="@style/TextAppearance.CozyKey.Caption"
                        android:textColor="@color/success"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ô 2: Phòng trống -->
            <com.google.android.material.card.MaterialCardView
                android:background="@drawable/bg_pill_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phòng trống"
                        android:textAppearance="@style/TextAppearance.CozyKey.Caption"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvStatAvailable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_status_warning"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0 phòng"
                        android:textAppearance="@style/TextAppearance.CozyKey.Caption"
                        android:textColor="@color/warning"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ô 3: Sự cố -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CozyKey.Card.Variant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sự cố"
                        android:textAppearance="@style/TextAppearance.CozyKey.Caption"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvStatMaintenance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_status_error"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0 phòng"
                        android:textAppearance="@style/TextAppearance.CozyKey.Caption"
                        android:textColor="@color/error"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Nút chính chuyển sang danh sách phòng của tòa nhà -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenRooms"
            style="@style/Widget.CozyKey.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:minHeight="44dp"
            android:text="Xem danh sách phòng trọ →" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>