<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style cha bắt buộc để AAPT nhận diện prefix CozyKey -->
    <style name="TextAppearance.CozyKey" parent="TextAppearance.MaterialComponents.Body1" />
    <style name="Widget.CozyKey" parent="android:Widget" />

    <!-- ================================= -->
    <!-- TYPOGRAPHY -->
    <!-- ================================= -->

    <style name="TextAppearance.CozyKey.Headline">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CozyKey.Title">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CozyKey.Body">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CozyKey.Caption">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.CozyKey.Number">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CozyKey.BottomNav">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <!-- ================================= -->
    <!-- PRIMARY BUTTON -->
    <!-- ================================= -->

    <style name="Widget.CozyKey.Button.Primary"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>

        <item name="cornerRadius">8dp</item>
        <item name="strokeWidth">0dp</item>

        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>

        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>

    </style>


    <!-- ================================= -->
    <!-- SECONDARY BUTTON -->
    <!-- ================================= -->

    <style name="Widget.CozyKey.Button.Secondary"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/surface_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>

        <item name="cornerRadius">8dp</item>
        <item name="strokeWidth">0dp</item>

        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>

        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>

    </style>


    <!-- ================================= -->
    <!-- CARD -->
    <!-- ================================= -->

    <style name="Widget.CozyKey.Card"
        parent="Widget.MaterialComponents.CardView">

        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">8dp</item>

        <item name="cardElevation">0dp</item>

        <item name="strokeColor">@color/transparent</item>
        <item name="strokeWidth">0dp</item>

        <item name="contentPadding">0dp</item>

    </style>

    <style name="Widget.CozyKey.Card.Variant"
        parent="Widget.CozyKey.Card">

        <item name="cardBackgroundColor">@color/surface_variant</item>

    </style>


    <!-- ================================= -->
    <!-- INPUT -->
    <!-- ================================= -->

    <style name="Widget.CozyKey.Input">

        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>

        <item name="android:fontFamily">@font/plus_jakarta_sans</item>

    </style>

</resources>